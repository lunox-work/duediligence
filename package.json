{
  "name": "duediligence",
  "version": "0.4.0",
  "description": "Due diligence for AI coding agents: independent, hidden test suites written from the spec. The agent works against a public suite; a hidden suite it never sees judges the result.",
  "keywords": [
    "due-diligence",
    "independent-tests",
    "ai-agents",
    "coding-agents",
    "hidden-tests",
    "test-generation",
    "claude-code",
    "codex",
    "cursor",
    "evaluation",
    "acceptance-tests",
    "typescript",
    "python",
    "pytest",
    "jest",
    "go",
    "rust",
    "agent-skills",
    "claude-code-plugin"
  ],
  "homepage": "https://github.com/lunox-work/duediligence#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/duediligence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/duediligence.git"
  },
  "license": "MIT",
  "author": "Charlie Angriawan",
  "type": "module",
  "bin": {
    "duediligence": "bin/cli.mjs"
  },
  "exports": {
    ".": "./bin/cli.mjs",
    "./api": "./bin/api.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "prompts/",
    "template/",
    "template-python/",
    "template-go/",
    "template-rust/",
    "specs/duration-parse/",
    "!specs/duration-parse/confirmed.json",
    "!specs/duration-parse/confirming.json",
    "AGENTS.md",
    "README.md",
    "RESULTS.md",
    "skills/"
  ],
  "scripts": {
    "test": "node scripts/skill.mjs check && node test/api.mjs && node test/platform.mjs && node test/hosted.mjs && node test/smoke.mjs",
    "version": "node scripts/skill.mjs sync && git add skills .claude-plugin",
    "skill:check": "node scripts/skill.mjs check",
    "skill:sync": "node scripts/skill.mjs sync",
    "skill:pack": "node scripts/skill.mjs pack"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  }
}
