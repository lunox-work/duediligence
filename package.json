{
  "name": "independent-tests",
  "version": "0.3.0",
  "description": "Hidden, calibrated test suites for AI coding agents: a public suite the agent works against and a hidden suite it never sees that judges the result.",
  "keywords": [
    "ai-agents",
    "coding-agents",
    "hidden-tests",
    "test-generation",
    "claude-code",
    "codex",
    "cursor",
    "evaluation",
    "acceptance-tests",
    "typescript",
    "python",
    "pytest",
    "jest",
    "go",
    "rust"
  ],
  "homepage": "https://github.com/lunox-work/independent-tests#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/independent-tests/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/independent-tests.git"
  },
  "license": "MIT",
  "author": "Charlie Angriawan",
  "type": "module",
  "bin": {
    "independent-tests": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "prompts/",
    "template/",
    "template-python/",
    "template-go/",
    "template-rust/",
    "specs/duration-parse/",
    "!specs/duration-parse/confirmed.json",
    "!specs/duration-parse/confirming.json",
    "AGENTS.md",
    "README.md",
    "RESULTS.md",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  }
}
