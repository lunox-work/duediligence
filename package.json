{
  "name": "duediligence",
  "version": "0.3.0",
  "description": "Due diligence for AI coding agents: independent, hidden test suites written from the spec. The agent works against a public suite; a hidden suite it never sees judges the result.",
  "keywords": [
    "due-diligence",
    "independent-tests",
    "ai-agents",
    "coding-agents",
    "hidden-tests",
    "test-generation",
    "claude-code",
    "codex",
    "cursor",
    "evaluation",
    "acceptance-tests",
    "typescript",
    "python",
    "pytest",
    "jest",
    "go",
    "rust"
  ],
  "homepage": "https://github.com/lunox-work/duediligence#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/duediligence/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/duediligence.git"
  },
  "license": "MIT",
  "author": "Charlie Angriawan",
  "type": "module",
  "bin": {
    "duediligence": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "prompts/",
    "template/",
    "template-python/",
    "template-go/",
    "template-rust/",
    "specs/duration-parse/",
    "!specs/duration-parse/confirmed.json",
    "!specs/duration-parse/confirming.json",
    "AGENTS.md",
    "README.md",
    "RESULTS.md",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  }
}
